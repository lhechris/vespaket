APP_NAME=vespaket
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Configuration des informations de connexion à la
# base de données
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Gestion des informations de session
# par défaut la mémorisation des sessions se fait en BDD, mais 
# d'autres driver sont disponibles
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# REDIS n'est pas utilisé par le projet
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configurez les informations pour l'envoi de mail
# ! Les notifications par mail ne sont pas encore développé
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS n'est pas utilisé par le projet
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Connexion Google (facultative)
# Dans Google Cloud Console, configurez l'écran de consentement OAuth puis créez
# un ID client OAuth de type "Application Web".
# Ajoutez à ses URI de redirection autorisées la valeur de GOOGLE_REDIRECT_URI
# ci-dessous (elle doit correspondre à APP_URL + /auth/google/callback).
# Renseignez ensuite l'ID client et le secret obtenus.
GOOGLE_CLIENT_ID=xxxxxxx
GOOGLE_CLIENT_SECRET=xxxxxx
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Notifications push (facultatives)
# Après composer install et la création du fichier .env, générez les clés avec :
# php artisan webpush:vapid
# La commande renseigne VAPID_PUBLIC_KEY et VAPID_PRIVATE_KEY dans .env.
# Définissez VAPID_SUBJECT avec une adresse mail de contact ou l'URL de votre site.
VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxx
VAPID_SUBJECT=mailto:admin@example.com
